programa {
  funcao inicio() {
    /*
     variáveis e valores:  valorPago = 50.0
                           valorCompra = 37.5
      
      Pocessamento: troco = valorPago - valorCompra
      
      Saída: escreva("Troco: R$ ", troco, "\n") 
    */ 

    real valorPago, valorCompra, troco
    valorPago = 50.0
    valorCompra = 37.5
    troco = valorPago - valorCompra
    escreva("Troco: R$ ", troco, "\n")
  }
}
